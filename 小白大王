import gradio as gr
import cv2
import numpy as np

# Function to convert 2x3 affine matrix to 3x3 for matrix multiplication
def to_3x3(affine_matrix):
    return np.vstack([affine_matrix, [0, 0, 1]])

# Function to apply transformations based on user inputs
def apply_transform(image, scale, rotation, translation_x, translation_y, flip_horizontal):
    if image is None:
        return None

    # Convert the image from PIL format to a NumPy array
    image = np.array(image)
    
    # Pad the image to avoid boundary issues
    # 原代码逻辑：创建一个更大的白色画布，将原图居中
    h, w = image.shape[:2]
    pad_size = min(h, w) // 2
    new_h, new_w = h + pad_size * 2, w + pad_size * 2
    
    image_new = np.full((new_h, new_w, 3), 255, dtype=np.uint8)
    image_new[pad_size:pad_size+h, pad_size:pad_size+w] = image
    
    # 当前图像的中心点
    center = (new_w / 2, new_h / 2)

    ### FILL: Apply Composition Transform 
    
    # 1. 处理翻转 (Flip)
    # 翻转矩阵：如果是水平翻转，则 x 变为 -x 并平移回范围
    if flip_horizontal:
        # 围绕中心翻转的矩阵
        M_flip = np.array([
            [-1, 0, new_w],
            [0, 1, 0],
            [0, 0, 1]
        ], dtype=np.float32)
    else:
        M_flip = np.eye(3)

    # 2. 处理旋转和缩放 (Rotation & Scale)
    # cv2.getRotationMatrix2D 直接生成绕中心旋转和缩放的 2x3 矩阵
    M_rot_scale_2x3 = cv2.getRotationMatrix2D(center, rotation, scale)
    M_rot_scale = to_3x3(M_rot_scale_2x3)

    # 3. 处理平移 (Translation)
    M_trans = np.array([
        [1, 0, translation_x],
        [0, 1, translation_y],
        [0, 0, 1]
    ], dtype=np.float32)

    # 4. 矩阵组合 (Composition)
    # 矩阵乘法顺序：从右向左执行 -> 先翻转，再旋转/缩放，最后平移
    M_combined = M_trans @ M_rot_scale @ M_flip

    # 应用仿射变换
    # warpAffine 需要 2x3 矩阵，我们取组合矩阵的前两行
    transformed_image = cv2.warpAffine(
        image_new, 
        M_combined[:2, :], 
        (new_w, new_h), 
        borderMode=cv2.BORDER_CONSTANT, 
        borderValue=(255, 255, 255)
    )

    return transformed_image

