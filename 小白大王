import cv2
import numpy as np
import gradio as gr

# Global variables for storing source and target control points
points_src = []
points_dst = []
image = None

# Reset control points when a new image is uploaded
def upload_image(img):
    global image, points_src, points_dst
    points_src.clear()
    points_dst.clear()
    image = img
    return img

# Record clicked points and visualize them on the image
def record_points(evt: gr.SelectData):
    global points_src, points_dst, image
    x, y = evt.index[0], evt.index[1]

    # Alternate clicks between source and target points
    if len(points_src) == len(points_dst):
        points_src.append([x, y])
    else:
        points_dst.append([x, y])

    # Draw points (blue: source, red: target) and arrows on the image
    marked_image = image.copy()
    for pt in points_src:
        cv2.circle(marked_image, tuple(pt), 5, (255, 0, 0), -1)  # Blue for source (稍微调大了点半径便于观察)
    for pt in points_dst:
        cv2.circle(marked_image, tuple(pt), 5, (0, 0, 255), -1)  # Red for target

    # Draw arrows from source to target points
    for i in range(min(len(points_src), len(points_dst))):
        cv2.arrowedLine(marked_image, tuple(points_src[i]), tuple(points_dst[i]), (0, 255, 0), 2)

    return marked_image

# Point-guided image deformation (Moving Least Squares - Affine)
def point_guided_deformation(image, source_pts, target_pts, alpha=1.0, eps=1e-8):
    """
    Return
    ------
        A deformed image using Moving Least Squares (MLS) Affine deformation.
    """
    warped_image = np.array(image)
    
    # Check if we have enough complete pairs of points
    if len(source_pts) < 3 or len(target_pts) < 3 or len(source_pts) != len(target_pts):
        print("Please select at least 3 pairs of points for an affine transformation.")
        return warped_image
        
    h, w = warped_image.shape[:2]
    
    # 核心逻辑：使用“逆向映射 (Inverse Mapping)”
    # 我们遍历目标图像的每一个像素，反推它在原图中的位置，从而避免变形后出现空洞
    # p: 目标控制点 (Target points) -> 作为参考基准
    # q: 源控制点 (Source points)   -> 要映射回的坐标
    p = np.array(target_pts, dtype=np.float32)
    q = np.array(source_pts, dtype=np.float32)
    
    # 1. 生成目标图像的像素坐标网格
    grid_x, grid_y = np.meshgrid(np.arange(w), np.arange(h))
    v = np.column_stack([grid_x.ravel(), grid_y.ravel()])  # 形状: (H*W, 2)
    
    # 2. 计算权重 w_i
    # 每个像素受控制点影响的程度取决于距离的倒数
    dist_sq = np.sum((v[:, np.newaxis, :] - p[np.newaxis, :, :]) ** 2, axis=2)
    w_ij = 1.0 / (dist_sq ** alpha + eps)  # 形状: (H*W, N)
    
    # 3. 计算加权质心 (Weighted Centroids)
    sum_w = np.sum(w_ij, axis=1, keepdims=True)
    p_star = np.sum(w_ij[:, :, np.newaxis] * p[np.newaxis, :, :], axis=1) / sum_w  # (H*W, 2)
    q_star = np.sum(w_ij[:, :, np.newaxis] * q[np.newaxis, :, :], axis=1) / sum_w  # (H*W, 2)
    
    # 4. 去中心化向量
    p_hat = p[np.newaxis, :, :] - p_star[:, np.newaxis, :]  # (H*W, N, 2)
    q_hat = q[np.newaxis, :, :] - q_star[:, np.newaxis, :]  # (H*W, N, 2)
    
    # 5. 计算仿射变换矩阵 M
    # 使用 np.einsum 进行极其高效的张量批处理乘法
    A = np.einsum('vn,vni,vnj->vij', w_ij, p_hat, p_hat)  # (H*W, 2, 2)
    B = np.einsum('vn,vni,vnj->vij', w_ij, p_hat, q_hat)  # (H*W, 2, 2)
    
    # 解析法求 2x2 矩阵 A 的逆
    det_A = A[:, 0, 0] * A[:, 1, 1] - A[:, 0, 1] * A[:, 1, 0] + eps
    A_inv = np.empty_like(A)
    A_inv[:, 0, 0] = A[:, 1, 1] / det_A
    A_inv[:, 1, 1] = A[:, 0, 0] / det_A
    A_inv[:, 0, 1] = -A[:, 0, 1] / det_A
    A_inv[:, 1, 0] = -A[:, 1, 0] / det_A
    
    M = np.matmul(A_inv, B)  # (H*W, 2, 2)
    
    # 6. 计算最终的源图映射坐标
    v_minus_p_star = v - p_star
    mapped_v = np.matmul(v_minus_p_star[:, np.newaxis, :], M)[:, 0, :]
    map_coords = mapped_v + q_star  # (H*W, 2)
    
    # 7. 使用 OpenCV 重新映射图像
    map_x = map_coords[:, 0].reshape(h, w).astype(np.float32)
    map_y = map_coords[:, 1].reshape(h, w).astype(np.float32)
    
    warped_image = cv2.remap(
        warped_image, 
        map_x, 
        map_y, 
        interpolation=cv2.INTER_LINEAR, 
        borderMode=cv2.BORDER_REPLICATE
    )
    
    return warped_image

def run_warping():
    global points_src, points_dst, image

    if image is None:
        return None

    # Ensure source and target have matching lengths
    min_len = min(len(points_src), len(points_dst))
    warped_image = point_guided_deformation(
        image, 
        np.array(points_src[:min_len]), 
        np.array(points_dst[:min_len])
    )

    return warped_image

# Clear all selected points
def clear_points():
    global points_src, points_dst
    points_src.clear()
    points_dst.clear()
    return image

# Build Gradio interface
with gr.Blocks() as demo:
    gr.Markdown("# Moving Least Squares (MLS) Image Warping")
    gr.Markdown("1. **Upload** an image. \n2. **Click** on the left image to define points. First click is the source point (Blue), second click is where you want it to move (Red). Repeat for at least 3 pairs. \n3. Click **Run Warping**.")
    with gr.Row():
        with gr.Column():
            input_image = gr.Image(label="Upload Image", interactive=True, type="numpy")
            point_select = gr.Image(label="Click to Select Source and Target Points", interactive=True)

        with gr.Column():
            result_image = gr.Image(label="Warped Result")

    with gr.Row():
        run_button = gr.Button("Run Warping", variant="primary")
        clear_button = gr.Button("Clear Points")

    input_image.upload(upload_image, input_image, point_select)
    point_select.select(record_points, None, point_select)
    run_button.click(run_warping, None, result_image)
    clear_button.click(clear_points, None, point_select)

if __name__ == "__main__":
    demo.launch()